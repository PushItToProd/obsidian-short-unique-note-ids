{
	"name": "obsidian-short-unique-note-ids",
	"version": "1.0.0",
	"description": "Obsidian plugin for creating unique notes with short, hand-writable IDs",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"tsc": "tsc",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "npm run tsc && mocha"
	},
	"keywords": [],
	"author": "pushittoprod",
	"license": "MIT",
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.27.2",
		"mocha": "^11.7.4",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
